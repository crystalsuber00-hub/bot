# Copy to .env (never commit it). Loaded by scripts/run_bot.* and scripts/setup_mac.sh.
# Phone alerts: install the ntfy app and subscribe to this (hard-to-guess) topic.
NTFY_TOPIC=your-hard-to-guess-topic
# Which bot the auto-start runs: stocks.toml, spy03.toml, xsp.toml or config.toml
SPXBOT_CONFIG=stocks.toml
# From your app on developer.schwab.com, once it says Ready For Use.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# TRADIER_TOKEN=...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
